{
  "name": "azure-affirmation",
  "version": "1.1.0",
  "description": "Azure Functions app for affirmation API",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "npm run test:client && npm run test:functions",
    "test:client": "cd client && npm test -- --watchAll=false",
    "test:functions": "jest --config jest.config.ts"
  },
  "main": "dist/src/app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "mongodb": "^6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.x",
    "azure-functions-core-tools": "^4.x",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
