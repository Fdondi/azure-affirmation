{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "outDir": "../../dist/functions",
    "rootDir": ".",
    "sourceMap": true,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    "node_modules/**/*",
    "../../dist/**/*"
  ]
}
